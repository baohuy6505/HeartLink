@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hl-section">
    <div class="hl-blob" style="top:10%; right:-5%; width:600px; height:600px; background:radial-gradient(circle, rgba(114, 9, 183, 0.05) 0%, transparent 70%);"></div>

    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <h1 class="display-5 fw-extra-bold mb-0 text-gradient">Thành viên hệ thống</h1>
            <p class="hl-meta fs-5">Kiểm soát và hỗ trợ tài khoản người dùng</p>
        </div>
        <a href="/admin" class="btn btn-outline-dark hl-glass-card d-flex align-items-center gap-2 px-4 shadow-none">
            <i data-lucide="arrow-left" size="18"></i> Dashboard
        </a>
    </div>

    <!-- Advanced Filters -->
    <div class="hl-glass-card p-4 mb-5">
        <div class="row g-3 align-items-end">
            <div class="col-lg-3">
                <label class="form-label x-small fw-bold hl-meta">Tìm kiếm tổng hợp</label>
                <div class="position-relative">
                    <i data-lucide="search" class="position-absolute ms-3 top-50 translate-middle-y text-muted" size="18"></i>
                    <input id="kw" type="text" class="form-control rounded-pill ps-5 border-0 bg-white bg-opacity-50"
                           placeholder="Tên, Email hoặc SĐT..."
                           onkeydown="if(event.key==='Enter') loadUsers(1)" />
                </div>
            </div>

            <div class="col-lg-2">
                <label class="form-label x-small fw-bold hl-meta">Giới tính</label>
                <select id="f-gender" class="form-select rounded-pill px-4 border-0 bg-white bg-opacity-50">
                    <option value="">Tất cả</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="col-lg-2">
                <label class="form-label x-small fw-bold hl-meta">Thành phố</label>
                <input id="f-city" type="text" class="form-control rounded-pill px-4 border-0 bg-white bg-opacity-50" placeholder="HCM, HN..." />
            </div>

            <div class="col-lg-2">
                <label class="form-label x-small fw-bold hl-meta">Sinh từ</label>
                <input id="f-bdFrom" type="date" class="form-control rounded-pill px-4 border-0 bg-white bg-opacity-50" />
            </div>

            <div class="col-lg-2">
                <label class="form-label x-small fw-bold hl-meta">Trạng thái</label>
                <select id="f-status" class="form-select rounded-pill px-4 border-0 bg-white bg-opacity-50">
                    <option value="">Tất cả</option>
                    <option value="Active">Active</option>
                    <option value="Banned">Banned</option>
                </select>
            </div>

            <div class="col-lg-1">
                <button class="btn btn-primary w-100 rounded-pill py-2 shadow-sm" onclick="loadUsers(1)">
                    Lọc
                </button>
            </div>
        </div>
    </div>

    <!-- User Table -->
    <div id="usersMsg" class="alert hl-glass-card border-danger text-danger mb-4" style="display:none;"></div>

    <div class="hl-glass-card p-0 overflow-hidden">
        <div id="usersContainer" class="p-0">
            <div class="p-5 text-center hl-meta">
                <div class="hl-spinner mx-auto mb-3"></div>
                Đang truy xuất dữ liệu...
            </div>
        </div>
    </div>
</div>

<!-- ── Ban Modal ── -->
<div id="banModal" class="hl-modal-overlay" style="display:none; transition:0.3s;">
    <div class="hl-glass-card p-5" style="max-width:500px; width:90%; position:relative;">
        <h3 class="fw-extra-bold mb-3 d-flex align-items-center gap-2">
            <i data-lucide="shield-x" class="text-danger"></i> Khóa tài khoản
        </h3>
        <p class="hl-meta small mb-4">
            Hành động này sẽ ngăn người dùng truy cập vào hệ thống. Vui lòng cung cấp lý do vi phạm cụ thể.
        </p>

        <input type="hidden" id="banTargetId" />

        <div class="mb-4">
            <label class="form-label x-small fw-bold hl-meta">Lý do kỷ luật</label>
            <textarea id="banReason"
                      class="form-control rounded-4 p-3 border-0 bg-light shadow-none"
                      rows="3"
                      placeholder="Ví dụ: Spam tin nhắn, ngôn từ không chuẩn mực..."></textarea>
        </div>

        <div id="banModalMsg" class="alert hl-glass-card border-danger text-danger mb-4 small" style="display:none;"></div>

        <div class="d-flex gap-2">
            <button class="btn btn-danger flex-grow-1 py-3 shadow-lg" id="confirmBanBtn" onclick="confirmBan()">Xác nhận khóa</button>
            <button class="btn btn-outline-dark hl-glass-card px-4 border-0 shadow-none" onclick="closeBanModal()">Hủy</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;

        function getFilterValues() {
            return {
                keyword: document.getElementById('kw').value.trim(),
                gender: document.getElementById('f-gender').value,
                city: document.getElementById('f-city').value.trim(),
                bdFrom: document.getElementById('f-bdFrom').value,
                status: document.getElementById('f-status').value
            };
        }

        function setFilterValuesFromQuery() {
            const params = new URLSearchParams(window.location.search);

            const keyword = params.get('keyword') || '';
            const gender = params.get('gender') || '';
            const city = params.get('city') || '';
            const bdFrom = params.get('birthDateFrom') || '';
            const status = params.get('status') || '';
            const page = parseInt(params.get('page')) || 1;
        document.getElementById('kw').value = keyword;
            document.getElementById('f-gender').value = gender;
            document.getElementById('f-city').value = city;
            document.getElementById('f-bdFrom').value = bdFrom;
            document.getElementById('f-status').value = status;

            currentPage = page;
        }

        function updateBrowserUrl(page = 1) {
            const filters = getFilterValues();
            const params = new URLSearchParams();

            if (page > 1) params.set('page', page);
            if (filters.keyword) params.set('keyword', filters.keyword);
            if (filters.gender) params.set('gender', filters.gender);
            if (filters.city) params.set('city', filters.city);
            if (filters.bdFrom) params.set('birthDateFrom', filters.bdFrom);
            if (filters.status) params.set('status', filters.status);

            const newUrl = `${window.location.pathname}${params.toString() ? '?' + params.toString() : ''}`;
            window.history.replaceState({}, '', newUrl);
        }

        function escapeHtml(text) {
            if (text === null || text === undefined) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function loadUsers(page = 1) {
            currentPage = page;

            const { keyword, gender, city, bdFrom, status } = getFilterValues();

            updateBrowserUrl(page);

            let url = `/api/admin/dashboard/users?page=${page}&pageSize=15`;
            if (keyword) url += `&keyword=${encodeURIComponent(keyword)}`;
            if (gender)  url += `&gender=${encodeURIComponent(gender)}`;
            if (city)    url += `&city=${encodeURIComponent(city)}`;
            if (bdFrom)  url += `&birthDateFrom=${encodeURIComponent(bdFrom)}`;
            if (status)  url += `&status=${encodeURIComponent(status)}`;

            document.getElementById('usersContainer').innerHTML = `
                <div class="p-5 text-center hl-meta">
                    <div class="hl-spinner mx-auto mb-3"></div>
                    Tải dữ liệu...
                </div>`;

            try {
                const data = await HeartLink.apiFetch(url);

                if (!data || !Array.isArray(data.items) || data.items.length === 0) {
                    document.getElementById('usersContainer').innerHTML = `
                        <div class="p-5 text-center opacity-50">
                            <i data-lucide="user-x" size="48" class="mb-3"></i>
                            <div>Không tìm thấy thành viên nào</div>
                        </div>`;
                    lucide.createIcons();
                    return;
                }

                const tableRows = data.items.map(u => {
                    const avatar = HeartLink.avatarUrl(u.avatar, 'sm');

                    const safeEmail = escapeHtml(u.email || '—');
                    const safeGender = escapeHtml(u.gender || '—');
                    const safeLocation = escapeHtml(u.location || '—');
                    const safeFullName = HeartLink.escapeHtml(u.fullName || '—');

                    let statusBadge = '';
                    if (u.userRole === 'Admin') {
        statusBadge = '<span class="status-dot admin"></span>Admin';
                    } else if (u.status) {
                        statusBadge = '<span class="status-dot online"></span>Active';
                    } else {
                        statusBadge = '<span class="status-dot offline"></span>Banned';
                    }

                    let actionBtn = '';
                    if (u.userRole !== 'Admin') {
                        if (u.status) {
                            actionBtn = `<button class="btn btn-sm btn-outline-danger border-0 hl-glass-card shadow-none px-3" onclick="openBanModal(${u.accountID})">Khóa</button>`;
                        } else {
                            actionBtn = `<button class="btn btn-sm btn-outline-success border-0 hl-glass-card shadow-none px-3" onclick="unbanUser(${u.accountID})">Mở</button>`;
                        }
                    }

                    return `
                        <tr class="hover-row transition-all">
                            <td class="py-3 border-0 ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="${avatar}" class="hl-avatar-sm" />
                                    <div>
                                        <div class="fw-bold">${safeFullName}</div>
                                        <div class="hl-meta x-small">${safeEmail}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 border-0 small hl-meta">${safeGender}</td>
                            <td class="py-3 border-0 small hl-meta">${HeartLink.formatDate(u.birthDate)}</td>
                            <td class="py-3 border-0 small hl-meta">${safeLocation}</td>
                            <td class="py-3 border-0 fw-medium text-gradient">${statusBadge}</td>
                            <td class="py-3 border-0 text-end pe-4">${actionBtn}</td>
                        </tr>`;
                }).join('');

                const totalPages = Math.max(1, Math.ceil((data.totalItems || 0) / (data.pageSize || 15)));

                const pagHtml = Array.from({ length: totalPages }, (_, i) => i + 1)
                    .map(p => `
                        <button class="hl-page-btn ${p === currentPage ? 'active' : ''}" onclick="loadUsers(${p})">
                            ${p}
                        </button>`)
                    .join('');

                document.getElementById('usersContainer').innerHTML = `
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-white bg-opacity-10">
                            <tr class="x-small hl-meta fw-bold text-uppercase" style="letter-spacing:0.1em;">
                                <th class="ps-4 border-0 py-3">Thành viên</th>
                                <th class="border-0 py-3">Phái</th>
                                <th class="border-0 py-3">Ngày sinh</th>
                                <th class="border-0 py-3">Vị trí</th>
                                <th class="border-0 py-3">Trạng thái</th>
                                <th class="border-0 py-3 text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
        <tbody>${tableRows}</tbody>
                    </table>
                    <div class="p-4 border-top border-white border-opacity-25 d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <span class="hl-meta small">Hiển thị ${data.items.length} trên ${data.totalItems} kết quả</span>
                        <div class="hl-pagination">${pagHtml}</div>
                    </div>`;

                lucide.createIcons();
            } catch (err) {
                HeartLink.showToast(err.message || 'Không thể tải danh sách người dùng', 'danger');
            }
        }

        function openBanModal(id) {
            document.getElementById('banTargetId').value = id;
            document.getElementById('banReason').value = '';
            document.getElementById('banModal').style.display = 'flex';
        }

        function closeBanModal() {
            document.getElementById('banModal').style.display = 'none';
        }

        async function confirmBan() {
            const id = document.getElementById('banTargetId').value;
            const reason = document.getElementById('banReason').value.trim();

            if (!reason) {
                HeartLink.showToast('Vui lòng nhập lý do khóa', 'warning');
                return;
            }

            try {
                await HeartLink.apiFetch(`/api/admin/dashboard/users/${id}/ban`, {
                    method: 'POST',
                    body: { reason }
                });

                closeBanModal();
                await loadUsers(currentPage);
                HeartLink.showToast('Đã khóa tài khoản', 'success');
            } catch (err) {
                HeartLink.showToast(err.message || 'Khóa tài khoản thất bại', 'danger');
            }
        }

        async function unbanUser(id) {
            if (!confirm('Bạn muốn mở khóa tài khoản này?')) return;

            try {
                await HeartLink.apiFetch(`/api/admin/dashboard/users/${id}/unban`, {
                    method: 'POST'
                });

                await loadUsers(currentPage);
                HeartLink.showToast('Đã mở khóa tài khoản', 'success');
            } catch (err) {
                HeartLink.showToast(err.message || 'Mở khóa tài khoản thất bại', 'danger');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (!HeartLink.requireAdmin()) return;

            setFilterValuesFromQuery();
            loadUsers(currentPage);

            document.getElementById('f-gender').addEventListener('change', () => loadUsers(1));
            document.getElementById('f-status').addEventListener('change', () => loadUsers(1));
        });
    </script>

    <style>
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }

            .status-dot.online {
                background: #10b981;
                box-shadow: 0 0 8px #10b98188;
            }

            .status-dot.offline {
                background: #ef4444;
            }

            .status-dot.admin {
                background: #8b5cf6;
            }

        .hover-row:hover {
            background: rgba(255,255,255,0.15);
        }

        .transition-all {
            transition: all 0.3s ease;
        }

        .x-small {
            font-size: 0.7rem;
        }
    </style>
}