<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HeartLink</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- HeartLink Ultra-Premium CSS -->
    <link rel="stylesheet" href="~/css/heartlink.css" asp-append-version="true" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    @RenderSection("Styles", required: false)
</head>
<body>

<nav class="navbar navbar-expand-lg hl-navbar fixed-top">
    <div class="container px-4">
        <a class="navbar-brand fw-extra-bold fs-2" href="/">
            <span class="text-gradient">HeartLink</span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#hlNav">
            <i data-lucide="menu" size="28"></i>
        </button>

        <div class="collapse navbar-collapse" id="hlNav">
            <ul class="navbar-nav mx-auto gap-4">
                <li class="nav-item auth-only">
                    <a class="nav-link fw-bold d-flex align-items-center gap-2" href="/discovery">
                        <i data-lucide="sparkles" size="18"></i> <span>Khám phá</span>
                    </a>
                </li>
                <li class="nav-item auth-only">
                    <a class="nav-link fw-bold d-flex align-items-center gap-2" href="/matches">
                        <i data-lucide="heart" size="18"></i> <span>Ghép đôi</span>
                    </a>
                </li>
                <li class="nav-item auth-only">
                    <a class="nav-link fw-bold d-flex align-items-center gap-2" href="/profile">
                        <i data-lucide="user" size="18"></i> <span>Hồ sơ</span>
                    </a>
                </li>
                <li class="nav-item admin-only">
                    <a class="nav-link fw-bold text-danger d-flex align-items-center gap-2" href="/admin">
                        <i data-lucide="shield-check" size="18"></i> <span>Quản trị</span>
                    </a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-4">
                <span id="navUserInfo" class="small fw-bold hl-meta d-none d-xl-inline"></span>
                
                <a href="/login" class="btn btn-link text-dark text-decoration-none fw-bold guest-only">Đăng nhập</a>
                <a href="/register" class="btn btn-primary guest-only shadow-none">Tham gia ngay</a>

                <button id="btnLogout" class="btn btn-icon auth-only text-muted border-0 p-0" title="Đăng xuất">
                    <i data-lucide="log-out" size="22"></i>
                </button>
            </div>
        </div>
    </div>
</nav>

<main class="hl-main-content">
    @RenderBody()
</main>

<div id="hl-toast-container"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/heartlink.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        if(window.lucide) lucide.createIcons();
    });
</script>
@RenderSection("Scripts", required: false)
</body>
</html>