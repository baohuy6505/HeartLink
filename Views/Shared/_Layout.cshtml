<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HeartLink</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/heartlink.css" asp-append-version="true" />
</head>
<body>
    <header class="hl-header shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark hl-navbar">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">HeartLink</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hlNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="hlNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0" id="mainNavLinks">
                        <li class="nav-item"><a class="nav-link auth-only" href="/discovery">Khám phá</a></li>
                        <li class="nav-item"><a class="nav-link auth-only" href="/matches">Ghép đôi</a></li>
                        <li class="nav-item"><a class="nav-link auth-only" href="/profile">Hồ sơ</a></li>
                        <li class="nav-item"><a class="nav-link auth-only admin-only" href="/admin">Quản trị</a></li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <span id="navUserInfo" class="text-white-50 small"></span>

                        <a href="/login" class="btn btn-sm btn-light guest-only">Đăng nhập</a>
                        <a href="/register" class="btn btn-sm btn-outline-light guest-only">Đăng ký</a>

                        <button type="button" id="btnLogout" class="btn btn-sm btn-warning auth-only">
                            Đăng xuất
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-3">
            &copy; 2026 - HeartLink
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/heartlink.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>