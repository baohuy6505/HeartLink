@{
    ViewData["Title"] = "Hồ sơ của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div id="profileMessage" class="alert hl-glass-card border-danger text-danger mb-4" style="display:none;"></div>

    <div class="row g-5 justify-content-center">
        <!-- Sidebar Profile Info -->
        <div class="col-lg-4">
            <div class="hl-glass-card p-5 text-center position-relative overflow-hidden">
                <div class="hl-blob" style="width:200px; height:200px; top:-50px; left:-50px;"></div>
                
                <div class="position-relative d-inline-block mb-4">
                    <img id="pAvatar" class="hl-avatar-lg cursor-pointer" src="https://ui-avatars.com/api/?name=?" title="Bấm để đổi ảnh đại diện" onclick="document.getElementById('avatarInput').click()" />
                    <input type="file" id="avatarInput" hidden accept="image/*" onchange="handleAvatarUpload(this)" />
                    <div class="position-absolute bottom-0 end-0 bg-success border border-white p-2 rounded-circle" style="width:20px; height:20px; box-shadow:0 0 15px #198754;"></div>
                </div>
                
                <h2 id="pFullName" class="display-6 fw-extra-bold mb-1 text-gradient">--</h2>
                <p id="pBasicInfo" class="hl-meta fs-5 mb-4">--</p>
                           <div class="d-grid gap-2 mb-4">
                    <a href="/profile/edit" class="btn btn-primary py-3 d-flex align-items-center justify-content-center gap-2">
                        <i data-lucide="edit-3" size="20"></i> Chỉnh sửa hồ sơ
                    </a>
                    <button type="button" class="btn btn-outline-dark hl-glass-card shadow-none py-3 d-flex align-items-center justify-content-center gap-2" onclick="openPwdModal()">
                        <i data-lucide="key-round" size="20"></i> Đổi mật khẩu
                    </button>
                    <a href="/profile/filter" class="btn btn-outline-dark hl-glass-card shadow-none py-3 d-flex align-items-center justify-content-center gap-2">
                        <i data-lucide="settings" size="20"></i> Thiết lập tìm kiếm
                    </a>
                </div>

                <div class="row g-2 pt-3 border-top border-white border-opacity-25">
                    <div class="col-4 border-end border-white border-opacity-25">
                        <div id="pMatches" class="fw-bold fs-4">0</div>
                        <div class="hl-meta x-small">Matches</div>
                    </div>
                    <div class="col-4 border-end border-white border-opacity-25">
                        <div id="pLikes" class="fw-bold fs-4">0</div>
                        <div class="hl-meta x-small">Likes</div>
                    </div>
                    <div class="col-4">
                        <div id="pScore" class="fw-bold fs-4">99</div>
                        <div class="hl-meta x-small">Trust</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Showcase -->
        <div class="col-lg-8">
            <div class="hl-glass-card p-5 h-100 mb-5">
                <h3 class="fw-extra-bold mb-4 d-flex align-items-center gap-2">
                    <i data-lucide="quote" class="text-pink-600"></i> Giới thiệu
                </h3>
                <p id="pBio" class="fs-5 lh-lg opacity-75 mb-5">
                    Chưa có lời giới thiệu nào. Hãy thêm vài dòng để mọi người hiểu bạn hơn nhé!
                </p>

                <h3 class="fw-extra-bold mb-4 d-flex align-items-center gap-2">
                    <i data-lucide="sparkles" class="text-orange-500"></i> Sở thích
                </h3>
                <div id="pInterests" class="d-flex flex-wrap gap-2 mb-5">
                    <span class="hl-meta">Bạn chưa thêm sở thích nào.</span>
                </div>

                <h3 class="fw-extra-bold mb-4 d-flex align-items-center gap-2">
                    <i data-lucide="map-pin" class="text-blue-500"></i> Khu vực
                </h3>
                <div class="hl-glass-card p-4 bg-white bg-opacity-30">
                    <div id="pLocation" class="fs-5 fw-medium mb-1">--</div>
                    <div class="hl-meta small">Tọa độ GPS hiện tại được lưu để tìm kiếm quanh đây</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Change Password Modal ── -->
<div id="pwdModal" class="hl-modal-overlay" style="display:none; transition: 0.3s;">
    <div class="hl-glass-card p-5" style="max-width:420px; width:90%;">
        <h3 class="fw-extra-bold mb-4 d-flex align-items-center gap-2">
            <i data-lucide="key-round" class="text-pink-600"></i> Đổi mật khẩu
        </h3>
        
        <form id="pwdForm" class="d-grid gap-4">
            <div class="form-group">
                <label class="form-label x-small fw-bold hl-meta mb-2">Mật khẩu cũ</label>
                <input name="oldPassword" type="password" class="form-control rounded-pill border-0 bg-light px-4" required />
            </div>
            <div class="form-group">
                <label class="form-label x-small fw-bold hl-meta mb-2">Mật khẩu mới</label>
                <input name="newPassword" type="password" class="form-control rounded-pill border-0 bg-light px-4" required />
            </div>
            <div class="form-group">
                <label class="form-label x-small fw-bold hl-meta mb-2">Xác nhận mật khẩu mới</label>
                <input name="confirmNewPassword" type="password" class="form-control rounded-pill border-0 bg-light px-4" required />
            </div>
            <div id="pwdMsg" class="alert small hl-glass-card border-danger text-danger mb-0" style="display:none;"></div>
            
            <div class="d-flex gap-2 mt-2">
                <button type="submit" id="pwdBtn" class="btn btn-primary flex-grow-1 py-3">Cập nhật</button>
                <button type="button" class="btn btn-outline-dark border-0 hl-glass-card shadow-none" onclick="closePwdModal()">Hủy</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', async () => {
    const auth = HeartLink.requireAuth();
    if (!auth) return;

    try {
        const p = await HeartLink.apiFetch('/api/client/profile/me');
        document.getElementById('pFullName').textContent = p.fullName;
        document.getElementById('pBasicInfo').textContent = `${p.age} tuổi • ${p.gender}`;
        document.getElementById('pAvatar').src = HeartLink.avatarUrl(p.avatar, 'lg');
        document.getElementById('pBio').textContent = p.bio || 'Hãy thêm vài dòng giới thiệu về bản thân bạn nhé!';
        document.getElementById('pLocation').textContent = p.location || 'Hồ Chí Minh, Việt Nam';

        if (p.interests && p.interests.length > 0) {
            document.getElementById('pInterests').innerHTML = p.interests.map(i => `
                <span class="badge bg-white bg-opacity-40 text-dark border-0 shadow-sm rounded-pill px-4 py-2 hover-scale" style="transition:0.3s;">
                    # ${HeartLink.escapeHtml(i)}
                </span>
            `).join('');
        }
        lucide.createIcons();
    } catch (err) { HeartLink.showToast(err.message, 'danger'); }
});

async function handleAvatarUpload(input) {
    if (!input.files || !input.files[0]) return;
    
    const file = input.files[0];
    try {
        HeartLink.showToast('Đang tải ảnh lên...', 'info');
        const { url } = await HeartLink.uploadAvatar(file);
        
        // Update profile in DB
        const profile = await HeartLink.apiFetch('/api/client/profile/me');
        profile.avatar = url;
        
        // Using existing UpdateProfile API
        // We need to send all required fields or the API might fail if it's strict
        // Let's call the update endpoint
        await HeartLink.apiFetch('/api/client/profile/update', {
            method: 'PUT',
            body: { 
                fullName: profile.fullName,
                gender: profile.gender,
                birthDate: profile.birthDate,
                avatar: url,
                bio: profile.bio,
                location: profile.location,
                interests: profile.interests,
                targetGender: profile.targetGender,
                minAge: profile.minAge,
                maxAge: profile.maxAge,
                radius: profile.radius,
                latitude: profile.latitude,
                longitude: profile.longitude
            }
        });

        document.getElementById('pAvatar').src = HeartLink.avatarUrl(url, 'lg');
        HeartLink.showToast('Đã cập nhật ảnh đại diện! ✨', 'success');
        
        // Refresh navbar if needed (though navbar usually uses email/name)
    } catch (err) {
        HeartLink.showToast(err.message, 'danger');
    } finally {
        input.value = '';
    }
}

function openPwdModal() { document.getElementById('pwdModal').style.display = 'flex'; }
function closePwdModal() { document.getElementById('pwdModal').style.display = 'none'; }

document.getElementById('pwdForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target;
    const btn = document.getElementById('pwdBtn');
    const msg = document.getElementById('pwdMsg');
    
    msg.style.display = 'none';
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`;

    try {
        await HeartLink.apiFetch('/api/client/auth/change-password', {
            method: 'POST',
            body: { 
                oldPassword: f.oldPassword.value, 
                newPassword: f.newPassword.value,
                confirmNewPassword: f.confirmNewPassword.value
            }
        });
        HeartLink.showToast('Đã đổi mật khẩu thành công! 🔑', 'success');
        closePwdModal();
        f.reset();
    } catch (err) {
        msg.textContent = err.message;
        msg.style.display = 'block';
    } finally {
        btn.disabled = false;
        btn.innerHTML = 'Cập nhật';
    }
});
</script>
<style>
.x-small { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; }
.hover-scale:hover { transform: scale(1.05); background: white !important; }
</style>
}