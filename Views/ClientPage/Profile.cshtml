@{
    ViewData["Title"] = "Hồ sơ của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="hl-page-title mb-1">👤 Hồ sơ của tôi</h1>
        <div class="hl-subtitle mb-0">Thông tin cá nhân và sở thích của bạn</div>
    </div>
    <div class="hl-actions">
        <a class="btn btn-primary" href="/profile/edit">✏️ Chỉnh sửa</a>
        <a class="btn btn-outline-secondary" href="/profile/filter">⚙️ Bộ lọc</a>
        <a class="btn btn-outline-secondary" href="/change-password">🔒 Đổi mật khẩu</a>
    </div>
</div>

<div id="profileMessage" class="alert" style="display:none;"></div>
<div id="profileContainer">
    <div class="hl-loading"><div class="hl-spinner"></div><div>Đang tải hồ sơ...</div></div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', async () => {
    if (!HeartLink.requireAuth()) return;

    try {
        const d = await HeartLink.apiFetch('/api/client/profile/me');
        const interests = (d.interests || []).map(x =>
            `<span class="hl-badge">${HeartLink.escapeHtml(x)}</span>`
        ).join('');

        const avatarUrl = d.avatar && d.avatar.trim()
            ? HeartLink.escapeHtml(d.avatar)
            : HeartLink.namedAvatar(d.fullName, 'lg');

        document.getElementById('profileContainer').innerHTML = `
            <div class="card hl-card">
                <div class="hl-profile-hero flex-wrap">
                    <div class="text-center">
                        <img class="hl-avatar" style="max-width:200px;"
                             src="${avatarUrl}"
                             onerror="this.src='${HeartLink.namedAvatar(d.fullName)}'"
                             alt="${HeartLink.escapeHtml(d.fullName)}" />
                    </div>
                    <div class="hl-profile-info flex-grow-1">
                        <h2>${HeartLink.escapeHtml(d.fullName)}, ${d.age}</h2>
                        <div class="hl-meta mb-3">${d.gender === 'Nam' ? '👨' : d.gender === 'Nữ' ? '👩' : '🧑'} ${HeartLink.escapeHtml(d.gender)}</div>

                        ${d.bio ? `<p style="line-height:1.7; color: var(--hl-text-2);">${HeartLink.escapeHtml(d.bio)}</p>` : ''}

                        <div class="row g-2 mt-2">
                            <div class="col-sm-6">
                                <div class="hl-info-row">
                                    <div class="hl-info-icon">📧</div>
                                    <span class="hl-meta">${HeartLink.escapeHtml(d.email)}</span>
                                </div>
                            </div>
                            ${d.phoneNumber ? `<div class="col-sm-6">
                                <div class="hl-info-row">
                                    <div class="hl-info-icon">📱</div>
                                    <span class="hl-meta">${HeartLink.escapeHtml(d.phoneNumber)}</span>
                                </div>
                            </div>` : ''}
                            ${d.location ? `<div class="col-sm-6">
                                <div class="hl-info-row">
                                    <div class="hl-info-icon">📍</div>
                                    <span class="hl-meta">${HeartLink.escapeHtml(d.location)}</span>
                                </div>
                            </div>` : ''}
                            ${d.latitude ? `<div class="col-sm-6">
                                <div class="hl-info-row">
                                    <div class="hl-info-icon">🗺️</div>
                                    <span class="hl-meta">GPS: ${d.latitude.toFixed(5)}, ${d.longitude.toFixed(5)}</span>
                                </div>
                            </div>` : ''}
                        </div>
                    </div>
                </div>

                <div class="px-4 pb-4">
                    <hr class="my-3" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="hl-profile-stat text-center">
                                <div class="hl-stat-title">TÌM KIẾM</div>
                                <div class="fw-bold mt-1">${HeartLink.escapeHtml(d.targetGender || 'Tất cả')}</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hl-profile-stat text-center">
                                <div class="hl-stat-title">ĐỘ TUỔI</div>
                                <div class="fw-bold mt-1">${d.minAge} – ${d.maxAge} tuổi</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hl-profile-stat text-center">
                                <div class="hl-stat-title">KHOẢNG CÁCH</div>
                                <div class="fw-bold mt-1">${d.radius} km</div>
                            </div>
                        </div>
                    </div>

                    ${interests ? `
                    <div class="mt-4">
                        <div class="hl-section-title mb-3">🎯 Sở thích</div>
                        <div>${interests}</div>
                    </div>` : ''}
                </div>
            </div>
        `;
    } catch (error) {
        HeartLink.showMessage('profileMessage', error.message, 'danger');
        document.getElementById('profileContainer').innerHTML = '';
    }
});
</script>
}