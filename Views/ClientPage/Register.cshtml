@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container py-4">
    <div class="card hl-card p-4 hl-form-card">
        <h1 class="hl-page-title text-center">Tạo tài khoản HeartLink</h1>
        <p class="hl-subtitle text-center">Bắt đầu hành trình kết nối của bạn</p>

        <div id="registerMessage" class="alert" style="display:none;"></div>

        <form id="registerForm" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input id="email" type="email" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Số điện thoại</label>
                <input id="phoneNumber" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Mật khẩu</label>
                <input id="password" type="password" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Xác nhận mật khẩu</label>
                <input id="confirmPassword" type="password" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Họ tên</label>
                <input id="fullName" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Ngày sinh</label>
                <input id="birthDate" type="date" class="form-control" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Giới tính</label>
                <select id="gender" class="form-select" required>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Muốn tìm</label>
                <select id="targetGender" class="form-select">
                    <option value="Tất cả">Tất cả</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Khoảng cách (km)</label>
                <input id="radius" type="number" class="form-control" value="50" min="1" max="500" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Tuổi tối thiểu</label>
                <input id="minAge" type="number" class="form-control" value="18" min="18" max="99" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Tuổi tối đa</label>
                <input id="maxAge" type="number" class="form-control" value="99" min="18" max="99" />
            </div>

            <div class="col-12">
                <label class="form-label">Bio</label>
                <textarea id="bio" class="form-control" rows="3" placeholder="Viết một vài dòng giới thiệu về bạn..."></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Địa điểm</label>
                <input id="location" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Avatar URL</label>
                <input id="avatar" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">Sở thích (cách nhau bởi dấu phẩy)</label>
                <input id="interests" class="form-control" placeholder="Đọc sách, Du lịch, Cà phê..." />
            </div>

            <div class="col-12 d-grid">
                <button class="btn btn-success" type="submit">Tạo tài khoản</button>
            </div>
        </form>

        <div class="text-center mt-4">
            Đã có tài khoản?
            <a href="/login" class="fw-semibold">Đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("registerForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        HeartLink.clearMessage("registerMessage");

        const minAge = parseInt(document.getElementById("minAge").value);
        const maxAge = parseInt(document.getElementById("maxAge").value);

        if (minAge > maxAge) {
            HeartLink.showMessage("registerMessage", "MinAge không được lớn hơn MaxAge.", "danger");
            return;
        }

        const interests = document.getElementById("interests").value
            .split(",")
            .map(x => x.trim())
            .filter(x => x.length > 0);

        try {
            const result = await HeartLink.apiFetch("/api/client/auth/register", {
                method: "POST",
                auth: false,
                body: {
                    email: document.getElementById("email").value.trim(),
                    password: document.getElementById("password").value,
                    confirmPassword: document.getElementById("confirmPassword").value,
                    phoneNumber: document.getElementById("phoneNumber").value.trim() || null,
                    fullName: document.getElementById("fullName").value.trim(),
                    birthDate: document.getElementById("birthDate").value,
                    gender: document.getElementById("gender").value,
                    bio: document.getElementById("bio").value.trim() || null,
                    location: document.getElementById("location").value.trim() || null,
                    avatar: document.getElementById("avatar").value.trim() || null,
                    targetGender: document.getElementById("targetGender").value,
                    minAge: minAge,
                    maxAge: maxAge,
                    radius: parseFloat(document.getElementById("radius").value),
                    interests: interests
                }
            });

            HeartLink.showMessage("registerMessage", result.message || "Đăng ký thành công. Vui lòng đăng nhập.", "success");
            setTimeout(() => window.location.href = "/login", 1200);
        } catch (error) {
            HeartLink.showMessage("registerMessage", error.message, "danger");
        }
    });
});
</script>
}