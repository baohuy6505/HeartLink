@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-5 col-md-7">
        <div class="card hl-card p-4 p-md-5">
            <div class="text-center mb-4">
                <span style="font-size:3rem;">💖</span>
                <h1 class="hl-page-title mt-2 mb-1">Tham gia HeartLink</h1>
                <p class="hl-subtitle">Tìm thấy một nửa của bạn ngay hôm nay</p>
            </div>

            <div id="regMessage" class="alert" style="display:none;"></div>

            <form id="regForm" novalidate>
                <!-- Section 1: Tài khoản -->
                <div class="hl-section-title mb-3" style="font-size:1.1rem;">🔐 Thông tin tài khoản</div>
                <div class="mb-3">
                    <label class="form-label" for="reg-email">Email <span class="text-danger">*</span></label>
                    <input id="reg-email" type="email" class="form-control" placeholder="name@example.com" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="reg-pw">Mật khẩu <span class="text-danger">*</span></label>
                        <input id="reg-pw" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="reg-cpw">Xác nhận <span class="text-danger">*</span></label>
                        <input id="reg-cpw" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <!-- Section 2: Cá nhân -->
                <div class="hl-section-title mb-3 mt-2" style="font-size:1.1rem;">👤 Thông tin cá nhân</div>
                <div class="mb-3">
                    <label class="form-label" for="reg-name">Họ và tên <span class="text-danger">*</span></label>
                    <input id="reg-name" type="text" class="form-control" placeholder="Nguyễn Văn A" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="reg-birth">Ngày sinh <span class="text-danger">*</span></label>
                        <input id="reg-birth" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="reg-gender">Giới tính <span class="text-danger">*</span></label>
                        <select id="reg-gender" class="form-select" required>
                            <option value="">Chọn...</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="reg-phone">Số điện thoại</label>
                    <input id="reg-phone" type="tel" class="form-control" placeholder="09xxxxxxxx" />
                </div>

                <button class="btn btn-primary w-100 py-3 mb-3" type="submit" id="regBtn">
                    ✨ Tạo tài khoản
                </button>
            </form>

            <div class="text-center mt-3">
                <span class="text-muted">Đã có tài khoản?</span>
                <a href="/login" class="fw-bold text-gradient ms-1">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    // If logged in, go to discovery
    if (HeartLink.getAuth()?.token) {
        window.location.href = '/discovery';
        return;
    }

    const regForm = document.getElementById('regForm');
    regForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        HeartLink.clearMessage('regMessage');

        const email     = document.getElementById('reg-email').value.trim();
        const password  = document.getElementById('reg-pw').value;
        const confirm   = document.getElementById('reg-cpw').value;
        const fullName  = document.getElementById('reg-name').value.trim();
        const birthDate = document.getElementById('reg-birth').value;
        const gender    = document.getElementById('reg-gender').value;
        const phone     = document.getElementById('reg-phone').value.trim();

        if (password !== confirm) {
            HeartLink.showMessage('regMessage', 'Mật khẩu xác nhận không khớp.', 'danger');
            return;
        }

        if (!email || !password || !fullName || !birthDate || !gender) {
            HeartLink.showMessage('regMessage', 'Vui lòng điền đầy đủ các thông tin bắt buộc (*).', 'danger');
            return;
        }

        const btn = document.getElementById('regBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="hl-spinner me-2" style="width:18px;height:18px;"></span> Đang xử lý...';

        try {
            await HeartLink.apiFetch('/api/client/auth/register', {
                method: 'POST',
                body: {
                    email,
                    password,
                    confirmPassword: confirm,
                    fullName,
                    birthDate,
                    gender,
                    phoneNumber: phone || null
                }
            });

            HeartLink.showToast('Đăng ký thành công! Đang chuyển hướng...', 'success');
            setTimeout(() => {
                window.location.href = '/login';
            }, 1500);
        } catch (err) {
            HeartLink.showMessage('regMessage', err.message, 'danger');
            btn.disabled = false;
            btn.innerHTML = '✨ Tạo tài khoản';
        }
    });
});
</script>
}