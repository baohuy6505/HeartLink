@{
    Layout = null; // Focused registration
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tham gia HeartLink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/heartlink.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            background: linear-gradient(135deg, #7209b7 0%, #ff4d6d 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .hl-auth-card {
            max-width: 480px;
            width: 100%;
            border-radius: 3.5rem;
            animation: slideUp 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        }
        @@keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .x-small { font-size: 0.7rem; letter-spacing: 0.1em; }
    </style>
</head>
<body>

<div class="hl-glass-card hl-auth-card p-5">
    <div class="text-center mb-5">
        <a href="/" class="text-decoration-none">
            <h1 class="display-5 fw-extra-bold text-gradient mb-0">HeartLink</h1>
        </a>
        <p class="hl-meta small mt-2">Bắt đầu hành trình tìm kiếm người ấy</p>
    </div>

    <div id="regMessage" class="alert hl-glass-card border-danger text-danger mb-4 small" style="display:none;"></div>

    <form id="regForm" class="row g-4">
        <div class="col-12">
            <label class="form-label x-small fw-bold text-uppercase hl-meta mb-3">Email của bạn</label>
            <div class="position-relative">
                <i data-lucide="mail" class="position-absolute ms-3 top-50 translate-middle-y text-muted" size="18"></i>
                <input name="email" type="email" class="form-control form-control-lg rounded-pill ps-5 border-0 bg-white bg-opacity-50 shadow-none fs-6" placeholder="example@mail.com" required />
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label x-small fw-bold text-uppercase hl-meta mb-3">Mật khẩu</label>
            <div class="position-relative">
                <i data-lucide="lock" class="position-absolute ms-3 top-50 translate-middle-y text-muted" size="18"></i>
                <input name="password" id="password" type="password" class="form-control form-control-lg rounded-pill ps-5 border-0 bg-white bg-opacity-50 shadow-none fs-6" placeholder="••••••••" required />
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label x-small fw-bold text-uppercase hl-meta mb-3">Số điện thoại</label>
            <div class="position-relative">
                <i data-lucide="phone" class="position-absolute ms-3 top-50 translate-middle-y text-muted" size="18"></i>
                <input name="phoneNumber" type="tel" class="form-control form-control-lg rounded-pill ps-5 border-0 bg-white bg-opacity-50 shadow-none fs-6" placeholder="0xxx..." required />
            </div>
        </div>

        <div class="col-12 pt-1 text-center">
            <p class="x-small text-muted mb-0">Bằng việc đăng ký, bạn đồng ý với <a href="#" class="text-pink-600 fw-bold">Điều khoản</a>.</p>
        </div>

        <div class="col-12">
            <button type="submit" id="regBtn" class="btn btn-primary btn-lg w-100 py-3 shadow-lg d-flex align-items-center justify-content-center gap-3">
                Khám phá ngay <i data-lucide="sparkles"></i>
            </button>
        </div>
    </form>

    <div class="text-center mt-5">
        <p class="hl-meta small">Đã có tài khoản? <a href="/login" class="fw-bold text-pink-600 text-decoration-none">Đăng nhập</a></p>
    </div>
</div>

<div id="hl-toast-container"></div>

<script src="/js/heartlink.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
    const f = document.getElementById('regForm');
    const msg = document.getElementById('regMessage');
    const btn = document.getElementById('regBtn');

    f.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.style.display = 'none';
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`;

        const password = f.password.value;

        try {
            const result = await HeartLink.apiFetch('/api/client/auth/register', {
                method: 'POST',
                body: {
                    email: f.email.value,
                    password: password,
                    confirmPassword: password, // Fulfillment of backend requirement
                    phoneNumber: f.phoneNumber.value
                },
                auth: false
            });

            HeartLink.setAuth(result.token, result.email, result.role, result.accountId, result.fullName);
            HeartLink.showToast('Chúc mừng! Tài khoản đã sẵn sàng. ✨', 'success');
            
            setTimeout(() => {
                location.href = '/profile/edit';
            }, 1000);
        } catch (error) {
            msg.textContent = error.message;
            msg.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = `Khám phá ngay <i data-lucide="sparkles"></i>`;
            lucide.createIcons();
        }
    });
});
</script>
</body>
</html>