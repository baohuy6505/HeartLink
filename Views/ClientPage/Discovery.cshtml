@{
    ViewData["Title"] = "Khám phá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hl-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h1 class="display-4 fw-extra-bold mb-1"><span class="text-gradient">Khám phá</span></h1>
                <p class="hl-meta mb-0 fs-5">Vuốt để bắt đầu câu chuyện của bạn</p>
            </div>
            <a href="/profile/filter" class="hl-glass-card px-4 py-2 text-decoration-none text-dark fw-bold d-flex align-items-center gap-2 hover-lift">
                <i data-lucide="sliders-horizontal" size="18"></i> Bộ lọc
            </a>
        </div>

        <div id="discoveryMessage" class="alert hl-glass-card border-danger text-danger mb-4" style="display:none;"></div>

        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div id="candidateContainer" class="position-relative" style="height: 650px;">
                    <!-- Loading State -->
                    <div class="hl-loading mt-5 text-center">
                        <div class="hl-spinner mx-auto mb-3"></div>
                        <div class="hl-meta">Đang tìm kiếm người phù hợp...</div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-4 mt-5">
                    <button id="btnPass" class="btn btn-white rounded-circle shadow-lg d-flex align-items-center justify-content-center border-0" 
                            style="width:80px; height:80px; background:white; color:#9fa6b2; transition: all 0.3s;"
                            onclick="manualSwipe('Pass')">
                        <i data-lucide="x" size="40"></i>
                    </button>
                    <button id="btnLike" class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center" 
                            style="width:80px; height:80px;"
                            onclick="manualSwipe('Like')">
                        <i data-lucide="heart" size="40"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Premium Match Popup -->
<div id="matchPopup" class="hl-match-popup" style="display:none;" onclick="closeMatchPopup()">
    <div class="hl-glass-card p-5 text-center" style="max-width: 450px; width: 90%;" onclick="event.stopPropagation()">
        <div class="display-1 mb-4" style="animation: pulse 2s infinite;">💖</div>
        <h2 class="display-5 fw-extra-bold mb-3 text-gradient">Tâm đầu ý hợp!</h2>
        <p class="fs-5 mb-5 opacity-75">Bạn và người ấy đã cùng thích nhau. Hãy bắt đầu kết nối ngay nào!</p>
        <div class="d-grid gap-3">
            <a id="matchPopupChatBtn" class="btn btn-primary btn-lg py-3" href="/matches">Nhắn tin ngay</a>
            <button class="btn btn-link text-muted fw-bold" onclick="closeMatchPopup()">Để sau</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let candidates = [];
let currentIndex = 0;
let isAnimating = false;

async function loadCandidates() {
    try {
        candidates = await HeartLink.apiFetch('/api/client/discovery/candidates?take=10');
        currentIndex = 0;
        renderCurrentCandidate();
    } catch (error) {
        HeartLink.showMessage('discoveryMessage', error.message, 'danger');
    }
}

function renderCurrentCandidate() {
    const container = document.getElementById('candidateContainer');

    if (!candidates.length || currentIndex >= candidates.length) {
        container.innerHTML = `
        <div class="hl-glass-card p-5 text-center mt-5">
            <div class="display-2 mb-3">✨</div>
            <h3 class="fw-bold mb-3">Đã hết hồ sơ quanh đây</h3>
            <p class="hl-meta mb-5">Thử thay đổi bộ lọc hoặc quay lại sau ít phút nhé!</p>
            <div class="d-grid gap-3">
                 <a href="/profile/filter" class="btn btn-primary py-3">Chỉnh sửa bộ lọc</a>
                 <button class="btn btn-outline-dark py-3" onclick="loadCandidates()">Tải lại trang</button>
            </div>
        </div>`;
        return;
    }

    const p = candidates[currentIndex];
    const avatar = HeartLink.avatarUrl(p.avatar, 'lg');
    const interests = (p.interests || []).slice(0, 3).map(x =>
        `<span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-2 small me-2 mb-2 backdrop-blur"># ${HeartLink.escapeHtml(x)}</span>`
    ).join('');

    container.innerHTML = `
        <div class="hl-discovery-card" id="discCard">
            <img class="hl-card-img" src="${avatar}" onerror="this.src='${HeartLink.namedAvatar(p.fullName, 'lg')}'" />
            <div class="hl-card-overlay">
                <div class="display-6 fw-extra-bold mb-2">${HeartLink.escapeHtml(p.fullName)}, ${p.age}</div>
                <div class="d-flex align-items-center gap-2 mb-3 small opacity-75">
                    <i data-lucide="map-pin" size="14"></i> ${HeartLink.escapeHtml(p.location || 'Hồ Chí Minh')}
                    <span class="mx-1">•</span> 
                    <i data-lucide="info" size="14"></i> ${HeartLink.escapeHtml(p.gender)}
                </div>
                <p class="small mb-4 text-white text-opacity-75">${HeartLink.escapeHtml(p.bio || 'Một ngày nắng đẹp cho một cuộc trò chuyện thú vị...')}</p>
                <div class="d-flex flex-wrap">
                    ${interests}
                </div>
            </div>
        </div>
    `;
    lucide.createIcons();
    isAnimating = false;
}

async function swipe(type) {
    if (isAnimating || currentIndex >= candidates.length) return;
    isAnimating = true;

    const card = document.getElementById('discCard');
    const p = candidates[currentIndex];

    if (card) {
        card.style.transform = `translate(${type === 'Like' ? '200px' : '-200px'}, -50px) rotate(${type === 'Like' ? '20deg' : '-20deg'})`;
        card.style.opacity = '0';
    }

    try {
        const result = await HeartLink.apiFetch('/api/client/discovery/swipe', {
            method: 'POST',
            body: { receiverID: p.accountID, type }
        });

        if (result.isMatched) showMatchPopup(result.matchId);

        setTimeout(() => {
            currentIndex++;
            renderCurrentCandidate();
        }, 300);
    } catch (error) {
        HeartLink.showToast(error.message, 'danger');
        isAnimating = false;
    }
}

function manualSwipe(type) {
    const btnId = type === 'Like' ? 'btnLike' : 'btnPass';
    const btn = document.getElementById(btnId);
    btn.style.transform = 'scale(1.2)';
    setTimeout(() => btn.style.transform = 'scale(1)', 200);
    swipe(type);
}

function showMatchPopup(matchId) {
    const popup = document.getElementById('matchPopup');
    if (matchId) document.getElementById('matchPopupChatBtn').href = `/messages/${matchId}`;
    popup.style.display = 'flex';
}

function closeMatchPopup() {
    document.getElementById('matchPopup').style.display = 'none';
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') manualSwipe('Like');
    if (e.key === 'ArrowLeft') manualSwipe('Pass');
});

document.addEventListener('DOMContentLoaded', () => {
    if (HeartLink.requireAuth()) loadCandidates();
});
</script>
<style>
.backdrop-blur { backdrop-filter: blur(8px); }
.hl-match-popup {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.4); backdrop-filter: blur(15px);
    z-index: 10001; display: flex; align-items: center; justify-content: center;
}
@@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
</style>
}