@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-5 col-md-7">
        <div class="card hl-card p-4 p-md-5">
            <div class="text-center mb-4">
                <span style="font-size:2.5rem;">🔒</span>
                <h1 class="hl-page-title mt-2 mb-1">Đổi mật khẩu</h1>
                <p class="hl-subtitle">Bảo vệ tài khoản của bạn</p>
            </div>

            <div id="cpMessage" class="alert" style="display:none;"></div>

            <form id="cpForm" novalidate>
                <div class="mb-3">
                    <label class="form-label" for="cpOld">Mật khẩu hiện tại</label>
                    <input id="cpOld" type="password" class="form-control"
                           placeholder="••••••••" autocomplete="current-password" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="cpNew">Mật khẩu mới</label>
                    <input id="cpNew" type="password" class="form-control"
                           placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" required />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="cpConfirm">Xác nhận mật khẩu mới</label>
                    <input id="cpConfirm" type="password" class="form-control"
                           placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required />
                </div>

                <button class="btn btn-warning w-100 py-3" type="submit" id="cpBtn">
                    🔒 Đổi mật khẩu
                </button>
            </form>

            <div class="text-center mt-4">
                <a href="/profile" class="text-muted" style="font-size:0.9rem;">← Quay lại hồ sơ</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    if (!HeartLink.requireAuth()) return;

    document.getElementById('cpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        HeartLink.clearMessage('cpMessage');

        const newPw  = document.getElementById('cpNew').value;
        const confPw = document.getElementById('cpConfirm').value;

        if (newPw !== confPw) {
            HeartLink.showMessage('cpMessage', 'Mật khẩu xác nhận không khớp.', 'danger');
            return;
        }

        if (newPw.length < 6) {
            HeartLink.showMessage('cpMessage', 'Mật khẩu mới phải có ít nhất 6 ký tự.', 'danger');
            return;
        }

        const btn = document.getElementById('cpBtn');
        btn.disabled = true;
        btn.textContent = 'Đang xử lý...';

        try {
            const result = await HeartLink.apiFetch('/api/client/auth/change-password', {
                method: 'POST',
                body: {
                    oldPassword:      document.getElementById('cpOld').value,
                    newPassword:      newPw,
                    confirmNewPassword: confPw
                }
            });

            HeartLink.showToast(result.message || 'Đổi mật khẩu thành công!', 'success');
            document.getElementById('cpForm').reset();
        } catch (err) {
            HeartLink.showMessage('cpMessage', err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.textContent = '🔒 Đổi mật khẩu';
        }
    });
});
</script>
}