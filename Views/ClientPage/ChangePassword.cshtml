@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card hl-card p-4">
            <h1 class="hl-page-title text-center">Đổi mật khẩu</h1>

            <div id="changePasswordMessage" class="alert" style="display:none;"></div>

            <form id="changePasswordForm">
                <div class="mb-3">
                    <label class="form-label">Mật khẩu cũ</label>
                    <input id="oldPassword" type="password" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu mới</label>
                    <input id="newPassword" type="password" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Xác nhận mật khẩu mới</label>
                    <input id="confirmNewPassword" type="password" class="form-control" required />
                </div>

                <button class="btn btn-warning w-100" type="submit">Đổi mật khẩu</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", () => {
    if (!HeartLink.requireAuth()) return;

    document.getElementById("changePasswordForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        try {
            const result = await HeartLink.apiFetch("/api/client/auth/change-password", {
                method: "POST",
                body: {
                    oldPassword: document.getElementById("oldPassword").value,
                    newPassword: document.getElementById("newPassword").value,
                    confirmNewPassword: document.getElementById("confirmNewPassword").value
                }
            });

            HeartLink.showMessage("changePasswordMessage", result.message || "Đổi mật khẩu thành công.", "success");
            document.getElementById("changePasswordForm").reset();
        } catch (error) {
            HeartLink.showMessage("changePasswordMessage", error.message, "danger");
        }
    });
});
</script>
}