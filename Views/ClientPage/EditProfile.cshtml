@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div id="editMessage" class="alert hl-glass-card border-danger text-danger mb-4" style="display:none;"></div>

            <form id="editForm" class="hl-glass-card p-5 overflow-hidden position-relative">
                <div class="hl-blob" style="width:300px; height:300px; top:-100px; right:-100px; background:radial-gradient(circle, rgba(114, 9, 183, 0.08) 0%, transparent 70%);"></div>
                
                <h1 class="display-5 fw-extra-bold mb-5"><span class="text-gradient">Chỉnh sửa hồ sơ</span></h1>

                <div class="row g-5">
                    <!-- Right: Avatar Upload -->
                    <div class="col-md-4 text-center">
                        <div class="position-relative d-inline-block group mb-4">
                            <img id="avatarPreview" class="hl-avatar-lg shadow-lg" 
                                 src="https://ui-avatars.com/api/?name=User" style="width:200px; height:200px;" />
                            <label for="avatarInput" class="position-absolute bottom-0 end-0 bg-primary text-white p-3 rounded-circle shadow-lg border border-white" style="cursor:pointer; transform: translate(5px, 5px);">
                                <i data-lucide="camera" size="24"></i>
                            </label>
                            <input type="file" id="avatarInput" class="d-none" accept="image/*" />
                        </div>
                        <p class="hl-meta small px-4">Nhấn vào biểu tượng máy ảnh để thay đổi hình ảnh đại diện của bạn.</p>
                        
                        <div class="hl-glass-card p-4 bg-white bg-opacity-30 mt-5">
                            <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-center gap-2">
                                <i data-lucide="map-pin" size="18" class="text-blue-500"></i> Vị trí
                            </h5>
                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-4 w-100 mb-2" onclick="getCurrentLocation()">
                                Cập nhật GPS
                            </button>
                            <div id="locationStatus" class="hl-meta x-small">Chưa cập nhật</div>
                        </div>
                    </div>

                    <!-- Left: Form Fields -->
                    <div class="col-md-8">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-bold small text-uppercase hl-meta">Họ và tên</label>
                                <input name="fullName" type="text" class="form-control form-control-lg rounded-pill px-4 border-0 shadow-sm" placeholder="Nhập họ tên..." required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-uppercase hl-meta">Ngày sinh</label>
                                <input name="birthDate" type="date" class="form-control form-control-lg rounded-pill px-4 border-0 shadow-sm" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-uppercase hl-meta">Giới tính</label>
                                <select name="gender" class="form-select form-select-lg rounded-pill px-4 border-0 shadow-sm">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-uppercase hl-meta">Lời giới thiệu</label>
                                <textarea name="bio" class="form-control rounded-4 px-4 py-3 border-0 shadow-sm" rows="4" placeholder="Viết gì đó thật thú vị về bản thân bạn..."></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-uppercase hl-meta">Sở thích (Cách nhau bằng dấu phẩy)</label>
                                <input name="interests" type="text" class="form-control form-control-lg rounded-pill px-4 border-0 shadow-sm" placeholder="Du lịch, Âm nhạc, Nấu ăn..." />
                            </div>

                            <div class="col-12 pt-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100 py-3 shadow-lg">
                                    Lưu thay đổi hồ sơ
                                </button>
                                <a href="/profile" class="btn btn-link w-100 mt-3 text-muted text-decoration-none small fw-medium">Quay lại hồ sơ</a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
let currentLat = null;
let currentLng = null;
let avatarFileName = null;

document.addEventListener('DOMContentLoaded', async () => {
    const auth = HeartLink.requireAuth();
    if (!auth) return;

    try {
        const p = await HeartLink.apiFetch('/api/client/profile/me');
        const f = document.getElementById('editForm');
        
        f.fullName.value = p.fullName || '';
        f.birthDate.value = p.birthDate ? p.birthDate.substring(0, 10) : '';
        f.gender.value = p.gender || 'Nam';
        f.bio.value = p.bio || '';
        f.interests.value = (p.interests || []).join(', ');
        
        document.getElementById('avatarPreview').src = HeartLink.avatarUrl(p.avatar, 'lg');
        avatarFileName = p.avatar;
        
        if (p.latitude && p.longitude) {
            document.getElementById('locationStatus').innerHTML = `<span class="text-success fw-bold">Đã lưu:</span> ${p.location || 'VN'}`;
        }

        lucide.createIcons();
    } catch (err) { HeartLink.showToast(err.message, 'danger'); }
});

// Image Preview & Upload
document.getElementById('avatarInput').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    // Local Preview
    const reader = new FileReader();
    reader.onload = (e) => document.getElementById('avatarPreview').src = e.target.result;
    reader.readAsDataURL(file);

    // Upload to server
    try {
        const result = await HeartLink.uploadAvatar(file);
        avatarFileName = result.url; // Corrected from result.fileName
        HeartLink.showToast('Tải ảnh lên thành công!', 'success');
    } catch (err) { HeartLink.showToast(err.message, 'danger'); }
});

async function getCurrentLocation() {
    const statusEl = document.getElementById('locationStatus');
    statusEl.innerHTML = '<div class="spinner-border spinner-border-sm text-primary"></div> Đang lấy...';
    
    if (!navigator.geolocation) {
        statusEl.textContent = 'Trình duyệt không hỗ trợ định vị.';
        return;
    }

    navigator.geolocation.getCurrentPosition(async (pos) => {
        currentLat = pos.coords.latitude;
        currentLng = pos.coords.longitude;
        statusEl.innerHTML = `<span class="text-success fw-bold">Tọa độ:</span> ${currentLat.toFixed(2)}, ${currentLng.toFixed(2)}`;
        HeartLink.showToast('Đã lấy được vị trí hiện tại.', 'info');
    }, (err) => {
        statusEl.textContent = 'Không thể lấy vị trí. Vui lòng bật GPS.';
    });
}

document.getElementById('editForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target;
    const body = {
        fullName: f.fullName.value,
        birthDate: f.birthDate.value,
        gender: f.gender.value,
        bio: f.bio.value,
        interests: f.interests.value.split(',').map(s => s.trim()).filter(s => s),
        avatar: avatarFileName,
        latitude: currentLat,
        longitude: currentLng
    };

    try {
        await HeartLink.apiFetch('/api/client/profile/update', {
            method: 'PUT',
            body: body
        });
        HeartLink.showToast('Cập nhật thành công!', 'success');
        setTimeout(() => location.href = '/profile', 1000);
    } catch (err) { HeartLink.showToast(err.message, 'danger'); }
});
</script>
<style>
    .x-small { font-size: 0.75rem; }
    .group label:hover { transform: translate(5px, 5px) scale(1.1) !important; filter: brightness(1.2); }
    .form-control:focus, .form-select:focus { background: white; border: 1px solid var(--hl-primary) !important; box-shadow: 0 0 20px rgba(255, 77, 109, 0.1) !important; }
</style>
}
