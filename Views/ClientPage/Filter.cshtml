@{
    ViewData["Title"] = "Cài đặt bộ lọc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card hl-card p-4 p-md-5 hl-form-card">
    <h1 class="hl-page-title mb-1">⚙️ Bộ lọc tìm kiếm</h1>
    <p class="hl-subtitle">Tinh chỉnh để tìm người phù hợp hơn với bạn</p>

    <div id="filterMessage" class="alert" style="display:none;"></div>

    <form id="filterForm" class="row g-4" novalidate>
        <div class="col-md-4">
            <label class="form-label">Muốn tìm giới tính</label>
            <select id="f-target" class="form-select">
                <option value="Tất cả">Tất cả</option>
                <option value="Nam">Nam 👨</option>
                <option value="Nữ">Nữ 👩</option>
                <option value="Khác">Khác</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Tuổi tối thiểu <span id="minAgeVal" class="text-gradient fw-bold"></span></label>
            <input id="f-minage" type="number" class="form-control" min="18" max="99" value="18"
                   oninput="document.getElementById('minAgeVal').textContent = '(' + this.value + ')'"/>
        </div>

        <div class="col-md-4">
            <label class="form-label">Tuổi tối đa <span id="maxAgeVal" class="text-gradient fw-bold"></span></label>
            <input id="f-maxage" type="number" class="form-control" min="18" max="99" value="45"
                   oninput="document.getElementById('maxAgeVal').textContent = '(' + this.value + ')'"/>
        </div>

        <div class="col-12">
            <label class="form-label">Khoảng cách tối đa (km) <span id="radiusVal" class="text-gradient fw-bold"></span></label>
            <input id="f-radius" type="range" class="form-range" min="1" max="500" value="50"
                   oninput="document.getElementById('radiusVal').textContent = this.value + ' km'"/>
            <div class="d-flex justify-content-between hl-meta mt-1">
                <span>1 km</span><span>500 km</span>
            </div>
        </div>

        <div class="col-12 d-flex gap-3 mt-2">
            <button class="btn btn-primary flex-grow-1 py-3" type="submit" id="saveFilterBtn">
                💾 Lưu bộ lọc
            </button>
            <a class="btn btn-outline-secondary" href="/discovery">🔥 Khám phá ngay</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', async () => {
    if (!HeartLink.requireAuth()) return;

    try {
        const p = await HeartLink.apiFetch('/api/client/profile/me');
        document.getElementById('f-target').value = p.targetGender || 'Tất cả';
        document.getElementById('f-minage').value = p.minAge || 18;
        document.getElementById('f-maxage').value = p.maxAge || 45;
        document.getElementById('f-radius').value = p.radius || 50;
        document.getElementById('minAgeVal').textContent = `(${p.minAge || 18})`;
        document.getElementById('maxAgeVal').textContent = `(${p.maxAge || 45})`;
        document.getElementById('radiusVal').textContent  = `${p.radius || 50} km`;
    } catch (err) {
        HeartLink.showMessage('filterMessage', err.message, 'danger');
    }

    document.getElementById('filterForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        HeartLink.clearMessage('filterMessage');

        const minAge = parseInt(document.getElementById('f-minage').value);
        const maxAge = parseInt(document.getElementById('f-maxage').value);
        if (minAge > maxAge) {
            HeartLink.showMessage('filterMessage', 'Tuổi tối thiểu không được lớn hơn tuổi tối đa.', 'danger');
            return;
        }

        const btn = document.getElementById('saveFilterBtn');
        btn.disabled = true;
        btn.textContent = 'Đang lưu...';

        try {
            const r = await HeartLink.apiFetch('/api/client/profile/filter', {
                method: 'PUT',
                body: {
                    targetGender: document.getElementById('f-target').value,
                    minAge, maxAge,
                    radius: parseFloat(document.getElementById('f-radius').value)
                }
            });
            HeartLink.showToast(r.message || 'Đã lưu bộ lọc!', 'success');
        } catch (err) {
            HeartLink.showMessage('filterMessage', err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.textContent = '💾 Lưu bộ lọc';
        }
    });
});
</script>
}