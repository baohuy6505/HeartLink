@{
    ViewData["Title"] = "Danh sách ghép đôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="hl-page-title mb-1">💞 Ghép đôi</h1>
        <div class="hl-subtitle mb-0">Những người đã cùng thích bạn</div>
    </div>
</div>

<div id="matchesMessage" class="alert" style="display:none;"></div>
<div id="matchesContainer">
    <div class="hl-loading"><div class="hl-spinner"></div><div>Đang tải danh sách...</div></div>
</div>

@section Scripts {
<script>
async function loadMatches() {
    try {
        const matches = await HeartLink.apiFetch('/api/client/matches');

        if (!matches.length) {
            document.getElementById('matchesContainer').innerHTML = HeartLink.emptyHtml(
                '💞', 'Chưa có ghép đôi nào',
                'Hãy khám phá và thích hồ sơ phù hợp để bắt đầu kết nối!'
            ) + `<div class="text-center mt-3">
                <a href="/discovery" class="btn btn-primary">🔥 Khám phá ngay</a>
            </div>`;
            return;
        }

        const auth = HeartLink.getAuth();
        const html = `<div class="hl-match-grid">` + matches.map(m => {
            const avatarUrl = m.otherUserAvatar && m.otherUserAvatar.trim()
                ? HeartLink.escapeHtml(m.otherUserAvatar)
                : HeartLink.namedAvatar(m.otherUserName, 'md');
            const hasUnread = m.unreadCount > 0;
            const preview = m.lastMessage
                ? HeartLink.escapeHtml(m.lastMessage.substring(0, 50)) + (m.lastMessage.length > 50 ? '...' : '')
                : '<span class="hl-meta">Chưa có tin nhắn</span>';

            return `
            <div class="card hl-card hl-match-card" onclick="window.location.href='/messages/${m.matchID}'">
                <div class="hl-match-card-top">
                    <img class="hl-avatar-md"
                         src="${avatarUrl}"
                         onerror="this.src='${HeartLink.namedAvatar(m.otherUserName)}'"
                         alt="${HeartLink.escapeHtml(m.otherUserName || 'User')}" />
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center gap-2">
                            <div class="hl-match-name">${HeartLink.escapeHtml(m.otherUserName || 'Người dùng')}</div>
                            ${hasUnread ? `<span class="hl-unread-badge">${m.unreadCount}</span>` : ''}
                        </div>
                        <div class="hl-match-preview">${preview}</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="hl-meta" style="font-size:0.8rem;">
                        ${m.lastMessageTime ? HeartLink.formatTimeShort(m.lastMessageTime) : HeartLink.formatDate(m.matchedDate)}
                    </span>
                    <div class="hl-actions">
                        <a class="btn btn-primary btn-sm" href="/messages/${m.matchID}"
                           onclick="event.stopPropagation()">💬 Nhắn tin</a>
                        <button class="btn btn-outline-danger btn-sm"
                                onclick="event.stopPropagation(); cancelMatch(${m.matchID})">Hủy</button>
                    </div>
                </div>
            </div>`;
        }).join('') + `</div>`;

        document.getElementById('matchesContainer').innerHTML = html;
    } catch (error) {
        HeartLink.showMessage('matchesMessage', error.message, 'danger');
        document.getElementById('matchesContainer').innerHTML = '';
    }
}

async function cancelMatch(matchId) {
    if (!confirm('Bạn chắc chắn muốn hủy kết nối này?')) return;
    try {
        await HeartLink.apiFetch(`/api/client/matches/${matchId}/cancel`, { method: 'POST' });
        HeartLink.showToast('Đã hủy kết nối.', 'info');
        loadMatches();
    } catch (error) {
        HeartLink.showToast(error.message, 'danger');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    if (!HeartLink.requireAuth()) return;
    loadMatches();
});
</script>
}