@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="hl-auth-wrap">
    <div class="container">
        <div class="card hl-card hl-auth-card">
            <div class="row g-0">
                <div class="col-lg-6">
                    <div class="hl-auth-left h-100 d-flex flex-column justify-content-center">
                        <div class="hl-auth-badge">HeartLink • Kết nối thật</div>
                        <h2>Tìm người phù hợp, bắt đầu từ một lần chạm.</h2>
                        <p class="mt-3 mb-0">
                            Đăng nhập để khám phá hồ sơ, ghép đôi, trò chuyện và kết nối với những người phù hợp với bạn.
                        </p>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="hl-auth-right">
                        <h1 class="hl-page-title text-center">Đăng nhập</h1>
                        <p class="hl-subtitle text-center">Chào mừng bạn quay lại với HeartLink</p>

                        <div id="loginMessage" class="alert" style="display:none;"></div>

                        <form id="loginForm">
                            <div class="mb-3">
                                <label class="form-label">Email hoặc số điện thoại</label>
                                <input id="emailOrPhone" class="form-control" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mật khẩu</label>
                                <input id="password" type="password" class="form-control" required />
                            </div>

                            <button class="btn btn-primary w-100" type="submit">Đăng nhập</button>
                        </form>

                        <div class="text-center mt-4">
                            Chưa có tài khoản?
                            <a href="/register" class="fw-semibold">Đăng ký ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", () => {
    const auth = HeartLink.getAuth();
    if (auth?.token) {
        window.location.href = auth.role === "Admin" ? "/admin" : "/discovery";
        return;
    }

    document.getElementById("loginForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        HeartLink.clearMessage("loginMessage");

        try {
            const result = await HeartLink.apiFetch("/api/client/auth/login", {
                method: "POST",
                auth: false,
                body: {
                    emailOrPhone: document.getElementById("emailOrPhone").value.trim(),
                    password: document.getElementById("password").value
                }
            });

            HeartLink.saveAuth(result);
            HeartLink.showMessage("loginMessage", result.message || "Đăng nhập thành công.", "success");
            window.location.href = result.role === "Admin" ? "/admin" : "/discovery";
        } catch (error) {
            HeartLink.showMessage("loginMessage", error.message, "danger");
        }
    });
});
</script>
}