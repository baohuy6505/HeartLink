@{
    Layout = null; // No header/navbar for focused login
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - HeartLink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/heartlink.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            background: linear-gradient(135deg, #ff4d6d 0%, #7209b7 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .hl-auth-card {
            max-width: 420px;
            width: 100%;
            border-radius: 3.5rem;
            animation: slideUp 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        }
        @@keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .x-small { font-size: 0.7rem; letter-spacing: 0.1em; }
    </style>
</head>
<body>

<div class="hl-glass-card hl-auth-card p-5">
    <div class="text-center mb-5">
        <a href="/" class="text-decoration-none">
            <h1 class="display-5 fw-extra-bold text-gradient mb-0">HeartLink</h1>
        </a>
        <p class="hl-meta small mt-2">Đăng nhập để tiếp tục hành trình</p>
    </div>

    <div id="loginMessage" class="alert hl-glass-card border-danger text-danger mb-4 small" style="display:none;"></div>

    <form id="loginForm" class="d-grid gap-4">
        <div class="form-group">
            <label class="form-label x-small fw-bold text-uppercase hl-meta mb-3">Email hoặc Số điện thoại</label>
            <div class="position-relative">
                <i data-lucide="mail" class="position-absolute ms-3 top-50 translate-middle-y text-muted" size="18"></i>
                <input name="email" type="text" class="form-control form-control-lg rounded-pill ps-5 border-0 bg-white bg-opacity-50 shadow-none fs-6" placeholder="admin@heartlink.com" required />
            </div>
        </div>

        <div class="form-group">
            <div class="d-flex justify-content-between mb-3">
                <label class="form-label x-small fw-bold text-uppercase hl-meta">Mật khẩu</label>
                <a href="#" class="x-small fw-bold text-pink-600 text-decoration-none">Quên?</a>
            </div>
            <div class="position-relative">
                <i data-lucide="lock" class="position-absolute ms-3 top-50 translate-middle-y text-muted" size="18"></i>
                <input id="password" name="password" type="password" class="form-control form-control-lg rounded-pill ps-5 border-0 bg-white bg-opacity-50 shadow-none fs-6" placeholder="••••••••" required />
                <i data-lucide="eye" id="togglePassword" class="position-absolute end-0 me-3 top-50 translate-middle-y text-muted" style="cursor:pointer;" size="18"></i>
            </div>
        </div>

        <button type="submit" id="loginBtn" class="btn btn-primary btn-lg py-3 mt-3 shadow-lg d-flex align-items-center justify-content-center gap-3">
            Đăng nhập <i data-lucide="arrow-right"></i>
        </button>
    </form>

    <div class="text-center mt-5">
        <p class="hl-meta small">Bạn là người mới? <a href="/register" class="fw-bold text-pink-600 text-decoration-none">Đăng ký ngay</a></p>
    </div>
</div>

<div id="hl-toast-container"></div>

<script src="/js/heartlink.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
    const f = document.getElementById('loginForm');
    const msg = document.getElementById('loginMessage');
    const btn = document.getElementById('loginBtn');

    document.getElementById('togglePassword').addEventListener('click', function() {
        const pwd = document.getElementById('password');
        const isPwd = pwd.getAttribute('type') === 'password';
        pwd.setAttribute('type', isPwd ? 'text' : 'password');
        this.setAttribute('data-lucide', isPwd ? 'eye-off' : 'eye');
        lucide.createIcons();
    });

    f.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.style.display = 'none';
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`;

        try {
            const data = await HeartLink.apiFetch('/api/client/auth/login', {
                method: 'POST',
                body: { emailOrPhone: f.email.value, password: f.password.value },
                auth: false
            });

            HeartLink.setAuth(data.token, data.email, data.role, data.accountId, data.fullName);
            HeartLink.showToast('Chào mừng trở lại! 💖', 'success');
            
            setTimeout(() => {
                location.href = data.role === 'Admin' ? '/admin' : '/discovery';
            }, 800);
        } catch (error) {
            msg.textContent = error.message;
            msg.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = `Đăng nhập <i data-lucide="arrow-right"></i>`;
            lucide.createIcons();
        }
    });
});
</script>
</body>
</html>