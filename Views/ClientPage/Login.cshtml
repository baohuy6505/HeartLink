@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hl-auth-wrap">
    <div class="container">
        <div class="card hl-card hl-auth-card border-0">
            <div class="row g-0 h-100">

                <!-- LEFT — Brand panel -->
                <div class="col-lg-5">
                    <div class="hl-auth-left h-100">
                        <div class="hl-auth-badge">💗 HeartLink • Kết nối thật</div>
                        <h2>Tìm người phù hợp, bắt đầu từ một lần chạm.</h2>
                        <p class="mt-3">Đăng nhập để khám phá những người phù hợp với bạn từ hàng nghìn hồ sơ thú vị.</p>

                        <div class="hl-auth-features mt-4">
                            <div class="hl-auth-feature">
                                <div class="feat-icon">🔥</div>
                                <span>Khám phá hồ sơ mỗi ngày</span>
                            </div>
                            <div class="hl-auth-feature">
                                <div class="feat-icon">💞</div>
                                <span>Kết đôi khi cả hai cùng thích</span>
                            </div>
                            <div class="hl-auth-feature">
                                <div class="feat-icon">💬</div>
                                <span>Nhắn tin và kết nối sâu hơn</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT — Form -->
                <div class="col-lg-7">
                    <div class="hl-auth-right h-100 d-flex flex-column justify-content-center">
                        <h1 class="hl-page-title text-center">Chào mừng trở lại 👋</h1>
                        <p class="hl-subtitle text-center mb-4">Đăng nhập vào tài khoản HeartLink của bạn</p>

                        <div id="loginMessage" class="alert" style="display:none;"></div>

                        <form id="loginForm" novalidate>
                            <div class="mb-3">
                                <label class="form-label" for="emailOrPhone">Email hoặc số điện thoại</label>
                                <input id="emailOrPhone" type="text" class="form-control"
                                       placeholder="example@email.com" autocomplete="username" required />
                            </div>

                            <div class="mb-4">
                                <label class="form-label" for="password">Mật khẩu</label>
                                <div class="input-group">
                                    <input id="password" type="password" class="form-control"
                                           placeholder="••••••••" autocomplete="current-password" required />
                                    <button type="button" class="btn btn-outline-secondary"
                                            id="togglePassword" tabindex="-1">👁</button>
                                </div>
                            </div>

                            <button class="btn btn-primary w-100 py-3" type="submit" id="loginBtn">
                                Đăng nhập
                            </button>
                        </form>

                        <div class="hl-divider my-4">hoặc</div>

                        <div class="text-center">
                            <span class="text-muted">Chưa có tài khoản?</span>
                            <a href="/register" class="fw-bold ms-1" style="color: var(--hl-primary);">Đăng ký ngay →</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    const auth = HeartLink.getAuth();
    if (auth?.token) {
        window.location.href = auth.role === 'Admin' ? '/admin' : '/discovery';
        return;
    }

    // Toggle password visibility
    document.getElementById('togglePassword').addEventListener('click', () => {
        const pw = document.getElementById('password');
        pw.type = pw.type === 'password' ? 'text' : 'password';
    });

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        HeartLink.clearMessage('loginMessage');

        const btn = document.getElementById('loginBtn');
        btn.disabled = true;
        btn.textContent = 'Đang đăng nhập...';

        try {
            const result = await HeartLink.apiFetch('/api/client/auth/login', {
                method: 'POST',
                auth: false,
                body: {
                    emailOrPhone: document.getElementById('emailOrPhone').value.trim(),
                    password:     document.getElementById('password').value
                }
            });

            HeartLink.saveAuth(result);
            HeartLink.showToast(result.message || 'Đăng nhập thành công!', 'success');
            setTimeout(() => {
                window.location.href = result.role === 'Admin' ? '/admin' : '/discovery';
            }, 400);
        } catch (error) {
            HeartLink.showMessage('loginMessage', error.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Đăng nhập';
        }
    });
});
</script>
}